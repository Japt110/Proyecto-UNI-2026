# ===============================================================================
# EVENTOS-UNI - VARIABLES DE ENTORNO Y CONFIGURACIÓN (LOCAL / RENDER / SUPABASE)
# ===============================================================================

# -------------------------------------------------------------------------------
# 1. ENTORNO Y SEGURIDAD CRIPTOGRÁFICA
# -------------------------------------------------------------------------------
FLASK_ENV=development
FLASK_DEBUG=1
SECRET_KEY=eventos-uni-secret-key-permanente-2026-production-v1
SESSION_COOKIE_SECURE=0

# -------------------------------------------------------------------------------
# 2. BASE DE DATOS PRINCIPAL (PostgreSQL Supabase o SQLite Local)
# -------------------------------------------------------------------------------
# Para operación local (por defecto usa app_local.db):
# DATABASE_URL=sqlite:///app_local.db

# Para despliegue con Supabase (Connection Pooling - Puerto 6543 o Directo 5432):
# DATABASE_URL=postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres?sslmode=require

# Para Réplica de Lectura Opcional:
# DATABASE_READ_URL=postgresql://postgres:[PASSWORD]@db-replica.[PROJECT-REF].supabase.co:5432/postgres?sslmode=require

# Parámetros del Pool de Conexiones
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800

# -------------------------------------------------------------------------------
# 3. REDIS (Sesiones de Usuario Compartidas y Caché Distribuido)
# -------------------------------------------------------------------------------
# En Render (Internal Redis URL): redis://red-xxxx:6379
# En Local / Docker: redis://localhost:6379/0
# REDIS_URL=redis://localhost:6379/0

# Cache timeout en segundos
CACHE_DEFAULT_TIMEOUT=300

# -------------------------------------------------------------------------------
# 4. RATE LIMITING Y PUERTO DEL GATEWAY
# -------------------------------------------------------------------------------
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=120
GATEWAY_PORT=8088

# -------------------------------------------------------------------------------
# 5. PERSISTENCIA DE IMÁGENES EN PRODUCCIÓN (Supabase Storage)
# -------------------------------------------------------------------------------
# Configure estas variables en Render para que las portadas se guarden en Supabase Storage
# SUPABASE_URL=https://[PROJECT-REF].supabase.co
# SUPABASE_KEY=[SUPABASE-ANON-KEY-O-SERVICE-ROLE]
# SUPABASE_BUCKET=eventos-portadas
